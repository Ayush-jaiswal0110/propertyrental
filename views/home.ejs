<% layout("/layouts/boilerplate") %>
<section class="home-hero">
  <img src="/images/reference/2367476f-11c4-4a14-a7c6-267be62c1d59.jpeg" alt="A welcoming living space with a private hot tub">
  <div class="home-hero-content"><h1>A little getaway.<br>A lot to discover.</h1><p>Find a place that feels like you. Explore beautiful homes for your next stay.</p><a class="outline-button" href="/listings">Explore homes <%- include('includes/icon',{name:'right'}) %></a></div>
</section>
<div class="section-heading"><div><h2>Make yourself at home</h2><p class="muted">Thoughtful spaces, memorable stays.</p></div><a href="/design-reference" class="text-action">Explore our featured stay <%- include('includes/icon',{name:'right'}) %></a></div>
<section class="home-features">
  <% [['Living spaces','a9831aeb-f441-44f5-a38f-4cf54e3f0fcf','Space to unwind and spend time together.'],['Room to relax','67c61c6f-6260-4809-9510-0360e58a345d','A comfortable base for your next adventure.'],['A change of scenery','fc02f48f-a937-42c5-895d-f9cc3113d6ca','Slow down and make the most of your time away.']].forEach(([title,image,description])=>{ %>
  <a class="listing-links" href="/listings"><img src="/images/reference/<%= image %>.jpeg" alt="<%= title %>" loading="lazy"><h2><%= title %></h2><p class="muted"><%= description %></p></a><% }) %>
</section>