<% layout("/layouts/boilerplate") %>
<section class="auth-panel"><h1>Welcome back</h1><p class="muted">Log in to book your next stay.</p>
<form action="/login" method="POST" class="needs-validation">
<label for="username">Username</label><input type="text" name="username" id="username" autocomplete="username" class="form-control" required>
<label for="password">Password</label><input type="password" name="password" id="password" autocomplete="current-password" class="form-control" required>
<button class="reserve-button">Log in</button></form>
<div class="social-auth"><% if(typeof oauthProviders !== 'undefined' && oauthProviders.google){ %><a class="outline-button" href="/auth/google"><i class="fab fa-google" aria-hidden="true"></i>Continue with Google</a><% } %><% if(typeof oauthProviders !== 'undefined' && oauthProviders.facebook){ %><a class="outline-button" href="/auth/facebook"><i class="fab fa-facebook" aria-hidden="true"></i>Continue with Facebook</a><% } %></div>
<p class="mt-4 mb-0">New here? <a href="/signup">Create an account</a></p></section>