<% layout("/layouts/boilerplate") %>
<%
const demo = typeof isReference !== 'undefined' && isReference;
const {photos, groups, reviews} = presentation;
const rating = listing.displayRating || presentation.rating;
const reviewCount = listing.reviewCount || reviews.length;
const host = listing.owner || {username:'Your host'};
const isOwner = currUser && host._id && String(host._id) === String(currUser._id);
const money = n => Number(n || 0).toLocaleString('en-IN', {maximumFractionDigits:0});
const heroPhotos = (listing.heroOrder || photos.map((_,i) => i)).slice(0,5);
const highlights = listing.highlights || [
  {icon:'home',title:'A place of your own',description:'Explore the photos and details before planning your stay.'},
  {icon:'location',title:listing.location + ', ' + listing.country,description:'Discover your next destination.'},
  {icon:'calendar',title:'Plan your stay',description:'Choose your arrival and departure dates.'}
];
const amenities = listing.amenities || [];
%>
<nav class="property-jumpbar" aria-label="Listing sections" hidden><div><a href="#photos">Photos</a><% if(amenities.length){ %><a href="#amenities">Amenities</a><% } %><a href="#reviews">Reviews</a><a href="#location-section">Location</a><a href="#availability" class="jump-reserve">Reserve</a></div></nav>
<article class="property-page" data-listing-id="<%= listing._id %>" data-reference="<%= demo %>">
  <div class="property-heading"><h1><%= listing.title %></h1><div class="property-actions">
    <button class="text-action" data-dialog-open="share-dialog"><%- include('../includes/icon',{name:'share'}) %><span>Share</span></button>
    <button class="text-action save-button" aria-pressed="false"><%- include('../includes/icon',{name:'heart'}) %><span>Save</span></button>
  </div></div>
  <% if (photos.length) { %>
  <section class="hero-gallery photo-count-<%= heroPhotos.length %>" aria-label="Property photos" id="photos">
    <% heroPhotos.forEach((index, slot) => { %><button class="hero-photo hero-photo-<%= slot %>" data-tour-open="<%= index %>" aria-label="Open photo tour: <%= photos[index].room %>"><%- include('../includes/photo',{photo:photos[index], eager:true}) %></button><% }) %>
    <button class="outline-button all-photos" data-tour-open="0"><%- include('../includes/icon',{name:'grid'}) %>Show all photos</button>
  </section>
  <% } else { %><div class="no-photo"><%- include('../includes/icon',{name:'home'}) %><p>Photos coming soon</p></div><% } %>
  <div class="property-columns">
    <div class="property-main">
      <section class="overview">
        <h2><%= listing.propertyType || 'Stay' %> in <%= listing.location %>, <%= listing.country %></h2>
        <p><%= listing.summary || 'Choose your dates and room type to plan your stay' %></p>
        <a class="rating-banner" href="#reviews">
          <% if (listing.guestFavourite) { %><span class="favourite-label"><img class="laurel" src="/images/reference/laurel-left.png" alt=""><strong>Guest<br>favourite</strong><img class="laurel right-laurel" src="/images/reference/laurel-right.png" alt=""></span><span class="rating-description">One of the most loved homes on Airbnb,<br>according to guests</span><% } else { %><span class="rating-description"><%- include('../includes/icon',{name:'star'}) %> Guest reviews</span><% } %>
          <span class="rating-number"><strong><%= rating || 'New' %></strong><span class="tiny-stars"><%= rating ? '★★★★★' : 'New listing' %></span></span><span class="review-count"><strong><%= reviewCount %></strong><span>Reviews</span></span>
        </a>
        <a class="host-line" href="#host"><% if (demo) { %><img class="avatar host-avatar" src="/images/reference/host.jpeg" alt="Mirashya Homes"><% } else { %><span class="avatar host-avatar"><%= host.username.slice(0,1) %></span><% } %><span><strong>Hosted by <%= host.username %></strong><small><%= listing.hostYears ? listing.hostYears + ' years hosting' : 'Property host' %></small></span></a>
      </section>
      <section class="property-section highlights"><% highlights.forEach(item => { %><div class="highlight"><%- include('../includes/icon',{name:item.icon}) %><div><h3><%= item.title %></h3><p><%= item.description %></p></div></div><% }) %></section>
      <section class="property-section description-section">
        <% if (demo) { %><div class="translation-note">Some info has been automatically translated. <button class="inline-link" data-dialog-open="description-dialog">Show original</button></div><% } %>
        <p class="description-preview"><%= listing.description || 'Contact the host for more information about this property.' %></p><button class="text-action" data-dialog-open="description-dialog">Show more <%- include('../includes/icon',{name:'right'}) %></button>
      </section>
      <% if ((listing.sleeping || []).length) { %><section class="property-section"><h2>Where you'll sleep</h2><div class="sleep-grid"><% listing.sleeping.forEach(room => { %><div><button class="sleep-photo" data-tour-open="<%= room.photo %>" aria-label="View <%= room.title %>"><%- include('../includes/photo',{photo:photos[room.photo]}) %></button><h3><%= room.title %></h3><p class="muted"><%= room.detail %></p></div><% }) %></div></section><% } %>
      <% if (amenities.length) { %><section class="property-section" id="amenities"><h2>What this place offers</h2><div class="amenities-grid"><% amenities.slice(0,10).forEach(item => { %><div class="amenity <%= item.unavailable ? 'unavailable' : '' %>"><%- include('../includes/icon',{name:item.icon}) %><span><%= item.label %></span></div><% }) %></div><button class="outline-button" data-dialog-open="amenities-dialog">Show all <%= listing.amenityCount || amenities.length %> amenities</button></section><% } %>
      <section class="property-section calendar-section" id="availability" aria-label="Choose dates">
        <h2 id="calendar-heading">Select your dates</h2><p id="calendar-summary" class="muted">Add your travel dates for pricing</p>
        <div class="calendar-navigation"><button class="circle-button" type="button" id="month-prev" aria-label="Previous month"><%- include('../includes/icon',{name:'left'}) %></button><button class="circle-button" type="button" id="month-next" aria-label="Next month"><%- include('../includes/icon',{name:'right'}) %></button></div>
        <div id="calendar-months" class="calendar-months"></div><div class="calendar-footer"><span class="muted">Select check-in, then checkout</span><button type="button" id="clear-dates" class="inline-link">Clear dates</button></div>
      </section>
    </div>
    <aside class="booking-column" aria-label="Reserve this property"><div class="booking-sticky">
      <% if (demo) { %><div class="offer-card"><img class="offer-icon" src="/images/reference/discount.svg" alt=""><p>Get 10% off your next stay.<br><button class="inline-link" data-dialog-open="offer-dialog">Terms apply</button></p><button class="soft-button" id="claim-offer">Claim</button></div><% } %>
      <div class="booking-card">
        <p class="booking-price"><strong id="booking-total">₹<%= money(listing.price) %></strong> <span id="booking-nights">per night</span></p>
        <form id="reservation-form" action="<%= demo ? '/design-reference' : '/bookings/' + listing._id + '/book' %>" method="POST" data-nightly-price="<%= listing.price || 0 %>" data-location="<%= listing.location %>" data-demo="<%= demo %>" data-owner="<%= !!isOwner %>" data-authenticated="<%= !!currUser %>">
          <div class="booking-fields">
            <label class="date-field">CHECK-IN<input type="date" id="checkIn" name="checkIn" required></label>
            <label class="date-field">CHECKOUT<input type="date" id="checkOut" name="checkOut" required></label>
            <% if (demo) { %><label class="guest-field">GUESTS<select id="guests" name="guests"><option value="1">1 guest</option><option value="2" selected>2 guests</option><option value="3">3 guests</option></select></label><% } else { %>
            <label class="guest-field">ROOM TYPE<select id="roomType" name="roomType"><option value="AC" <%= listing.roomsAcAvailable <= 0 ? 'disabled' : '' %>>AC · <%= listing.roomsAcAvailable %> available</option><option value="Non-AC" <%= listing.roomsNonAcAvailable <= 0 ? 'disabled' : '' %>>Non-AC · <%= listing.roomsNonAcAvailable %> available</option></select></label><% } %>
          </div>
          <% if (demo) { %><p class="cancellation-note">Free cancellation before <strong>17 October</strong></p><% } %>
          <p id="booking-error" class="field-error" role="alert" hidden></p>
          <button type="submit" class="reserve-button" <%= isOwner || (!demo && listing.roomsAcAvailable <= 0 && listing.roomsNonAcAvailable <= 0) ? 'disabled' : '' %>><%= isOwner ? 'Your property' : (!demo && listing.roomsAcAvailable <= 0 && listing.roomsNonAcAvailable <= 0) ? 'No rooms available' : 'Reserve' %></button>
          <p class="charge-note"><%= demo ? "You won't be charged yet" : 'Your booking confirmation follows reservation' %></p>
        </form>
      </div>
      <button class="report-link" data-dialog-open="report-dialog"><%- include('../includes/icon',{name:'flag'}) %>Report this listing</button>
      <% if (isOwner) { %><div class="owner-actions"><a class="outline-button" href="/listings/<%= listing._id %>/edit">Edit listing</a><form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"><button class="outline-button">Delete listing</button></form></div><% } %>
    </div></aside>
  </div>
  <section class="property-section reviews-section" id="reviews">
    <div class="review-summary"><div class="large-rating"><% if (listing.guestFavourite) { %><img class="laurel" src="/images/reference/laurel-left.png" alt=""><% } %><%= rating || 'New' %><% if (listing.guestFavourite) { %><img class="laurel right-laurel" src="/images/reference/laurel-right.png" alt=""><% } %></div><h2><%= listing.guestFavourite ? 'Guest favourite' : 'Guest reviews' %></h2><p><%= listing.guestFavourite ? 'This home is a guest favourite based on ratings, reviews and reliability' : reviews.length ? 'Experiences shared by guests who stayed here' : 'Be the first to share your experience' %></p><button class="inline-link" data-dialog-open="review-info-dialog">How reviews work</button></div>
    <% if (demo) { %><div class="rating-categories"><div><strong>Overall rating</strong><% for(let n=5;n>=1;n--) { %><div class="rating-bar"><span><%= n %></span><span><i style="width:<%= n===5 ? 95 : n===4 ? 5 : 0 %>%"></i></span></div><% } %></div>
    <% [['Cleanliness','5.0','home'],['Accuracy','5.0','check'],['Check-in','5.0','key'],['Communication','5.0','user'],['Location','4.8','location'],['Value','4.8','heart']].forEach(item=>{ %><div><strong><%= item[0] %></strong><p><%= item[1] %></p><%- include('../includes/icon',{name:item[2]}) %></div><% }) %></div><% } %>
    <% if (demo) { %><div class="review-topics" aria-label="Review topics"><% [['Comfort',6,'comfort'],['Accuracy',5,'accuracy'],['Hot tub',5,'hot-tub'],['Condition',4,'condition'],['Hospitality',8,'hospitality'],['Cleanliness',4,'cleanliness'],['Amenities',2,'amenities'],['Decor',2,'decor'],['Indoor spaces',2,'indoor-spaces'],['Location',2,'location']].forEach(([label,count,asset])=>{ %><button data-dialog-open="reviews-dialog"><img src="/images/reference/<%= asset %>.png" alt=""><%= label %> <span class="muted"><%= count %></span></button><% }) %></div><% } %>
    <div class="reviews-grid"><% reviews.slice(0,6).forEach(review => { %><article class="guest-review">
      <div class="review-person"><% if (review.avatar) { %><img class="avatar" src="<%= review.avatar %>" alt=""><% } else { %><span class="avatar"><%= (review.author?.username || 'Guest').slice(0,1) %></span><% } %><div><h3><%= review.author?.username || 'Guest' %></h3><small class="muted"><%= review.tenure || 'Guest' %></small></div></div>
      <div class="review-date"><span aria-label="<%= review.rating %> out of 5 stars"><%= '★'.repeat(Math.round(review.rating || 0)) %></span><% if (review.createdAt) { %> · <%= new Date(review.createdAt).toLocaleDateString('en-IN',{month:'long',year:'numeric'}) %><% } %></div>
      <p class="review-text"><%= review.comment %></p><% if ((review.comment || '').length > 180) { %><button class="inline-link" data-expand-review>Show more</button><% } %>
      <% if (!demo && currUser && review.author && String(review.author._id) === String(currUser._id)) { %><form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST"><button class="inline-link">Delete your review</button></form><% } %>
    </article><% }) %></div>
    <% if (reviews.length) { %><button class="outline-button" data-dialog-open="reviews-dialog">Show all <%= reviewCount %> reviews</button><% } %>
    <% if (!demo && currUser && !isOwner) { %><details class="write-review"><summary class="outline-button">Leave a review</summary><form class="needs-validation" action="/listings/<%= listing._id %>/reviews" method="POST">
      <label for="rating">Your rating</label><select id="rating" name="review[rating]" class="form-select" required><option value="5">5 — Excellent</option><option value="4">4 — Very good</option><option value="3">3 — Good</option><option value="2">2 — Fair</option><option value="1">1 — Poor</option></select>
      <label for="comment">Your experience</label><textarea class="form-control" name="review[comment]" id="comment" rows="4" required></textarea><button class="reserve-button">Submit review</button></form></details><% } %>
  </section>
  <section class="property-section location-section" id="location-section"><h2>Where you’ll be</h2><p><%= listing.location %><%= demo ? ', Goa' : '' %>, <%= listing.country %></p>
    <% if (demo) { %><div class="illustrated-map" role="img" aria-label="Illustration of the Candolim neighborhood"><div class="map-land"></div><div class="map-park park-one"></div><div class="map-park park-two"></div><span class="map-pin"><%- include('../includes/icon',{name:'home'}) %></span></div><p class="map-caption">Exact location will be provided after booking.</p><% } else if (listing.geometry?.coordinates?.length === 2 && typeof mapToken !== 'undefined' && mapToken) { %><div id="map" class="property-map" aria-label="Property location map"></div><% } else { %><div class="location-placeholder"><%- include('../includes/icon',{name:'location'}) %><span><%= listing.location %>, <%= listing.country %></span></div><% } %>
    <% if (listing.neighborhood) { %><h3>Neighbourhood highlights</h3><p><%= listing.neighborhood %></p><button class="text-action" data-dialog-open="neighborhood-dialog">Show more <%- include('../includes/icon',{name:'right'}) %></button><% } %>
  </section>
  <section class="property-section" id="host"><h2>Meet your host</h2><div class="host-section">
    <div class="host-profile"><% if (demo) { %><img class="avatar host-avatar" src="/images/reference/host.jpeg" alt="Mirashya Homes"><% } else { %><span class="avatar host-avatar"><%= host.username.slice(0,1) %></span><% } %><h2><%= host.username %></h2><p>Host</p><% if (demo) { %><div class="host-stats"><span><strong>1,463</strong>Reviews</span><span><strong>4.68★</strong>Rating</span><span><strong>2</strong>Years hosting</span></div><% } else if (listing.hostYears) { %><p><strong><%= listing.hostYears %></strong> years hosting</p><% } %></div>
    <div class="host-details"><% if (demo) { %><h3>Co-Hosts</h3><div class="cohosts"><% [['Sharath','co1.jpg'],['Aman Dev Pahwa','co2.jpg'],['Maria Karen Priyanka','co3.jpg'],['Simran','rev5.jpeg'],['Pallavi','rev1.jpeg'],['Sanyukta','rev2.jpeg'],['Shruti',null],['Amisha',null]].forEach(([name,avatar])=>{ %><span><% if(avatar){ %><img class="avatar" src="/images/reference/<%= avatar %>" alt=""><% } else { %><span class="avatar"><%= name[0] %></span><% } %><%= name %></span><% }) %></div><% } %><h3>Host details</h3><% if (demo) { %><p>Response rate: <strong>100%</strong><br>Responds within an hour</p><% } else { %><p>Hosted by <%= host.username %> in <%= listing.location %>.</p><% } %><button class="soft-button" data-dialog-open="host-dialog">Contact host</button><p class="host-safety"><%- include('../includes/icon',{name:'shield'}) %>Keep your booking and payment details on the platform.</p></div>
  </div></section>
  <section class="property-section"><h2>Things to know</h2><div class="things-grid">
    <div><%- include('../includes/icon',{name:'calendar'}) %><h3>Cancellation policy</h3><p><%= listing.cancellation || 'Review the booking conditions with your host before reserving.' %></p><button class="inline-link" data-dialog-open="policy-dialog">Learn more</button></div>
    <div><%- include('../includes/icon',{name:'key'}) %><h3>House rules</h3><% (listing.rules || ['Confirm check-in and checkout times with the host.']).forEach(rule=>{ %><p><%= rule %></p><% }) %><button class="inline-link" data-dialog-open="rules-dialog">Learn more</button></div>
    <div><%- include('../includes/icon',{name:'shield'}) %><h3>Safety & property</h3><% (listing.safety || ['Ask your host about safety equipment and property access.']).forEach(rule=>{ %><p><%= rule %></p><% }) %><button class="inline-link" data-dialog-open="safety-dialog">Learn more</button></div>
  </div></section>
  <% if (typeof nearbyListings !== 'undefined' && nearbyListings.length) { %><section class="property-section"><div class="nearby-heading"><h2><%= demo ? "More stays to explore" : "More stays nearby" %></h2><div><button class="circle-button" data-stay-step="-1" aria-label="Previous stays"><%- include('../includes/icon',{name:'left'}) %></button><button class="circle-button" data-stay-step="1" aria-label="Next stays"><%- include('../includes/icon',{name:'right'}) %></button></div></div><div class="nearby-grid" tabindex="0" aria-label="More properties"><% nearbyListings.forEach(item=>{ %><a href="<%= item.href || '/listings/'+item._id %>" class="listing-links"><img src="<%= item.image?.url %>" alt="<%= item.title %>" loading="lazy"><h3><%= item.title %></h3><p>₹<%= money(item.price) %> / night</p></a><% }) %></div></section><% } %>
</article>
<dialog id="photo-tour" class="fullscreen-dialog" aria-labelledby="tour-title">
  <header class="overlay-header"><button class="circle-button" data-dialog-close aria-label="Back to listing"><%- include('../includes/icon',{name:'left'}) %></button><h2 id="tour-title">Photo tour</h2><div><button class="circle-button" data-dialog-open="share-dialog" aria-label="Share"><%- include('../includes/icon',{name:'share'}) %></button><button class="circle-button save-button" aria-label="Save listing" aria-pressed="false"><%- include('../includes/icon',{name:'heart'}) %></button></div></header>
  <div class="tour-content"><nav class="room-navigation" aria-label="Rooms in photo tour"><% groups.forEach((group,i)=>{ %><a href="#room-<%= i %>" data-room-target="room-<%= i %>"><%- include('../includes/photo',{photo:group.photos[0]}) %><span><%= group.name %></span></a><% }) %></nav>
  <% groups.forEach((group,i)=>{ %><section class="tour-room" id="room-<%= i %>"><div class="room-description"><h3><%= group.name %></h3><% if (listing.roomDetails?.[group.name]) { %><p><%= listing.roomDetails[group.name] %></p><% } %></div><div class="room-photo-grid"><% group.photos.forEach(photo=>{ %><button class="tour-photo" data-lightbox-open="<%= photo.index %>" aria-label="View <%= photo.alt %>"><%- include('../includes/photo',{photo}) %></button><% }) %></div></section><% }) %>
  </div>
</dialog>
<dialog id="photo-lightbox" class="fullscreen-dialog lightbox" aria-labelledby="lightbox-title"><header class="overlay-header"><button class="circle-button" id="back-to-tour" aria-label="Back to photo tour"><%- include('../includes/icon',{name:'grid'}) %></button><h2 id="lightbox-title">Property photo</h2><div><span id="photo-counter" aria-live="polite"></span><button class="circle-button" data-dialog-close aria-label="Close photo"><%- include('../includes/icon',{name:'close'}) %></button></div></header><div class="lightbox-stage"><button class="circle-button photo-arrow" id="photo-prev" aria-label="Previous photo"><%- include('../includes/icon',{name:'left'}) %></button><div id="lightbox-image"></div><button class="circle-button photo-arrow" id="photo-next" aria-label="Next photo"><%- include('../includes/icon',{name:'right'}) %></button></div></dialog>
<% const dialogs = [
  ['description-dialog','About this space',listing.description],
  ['neighborhood-dialog','Neighbourhood highlights',listing.neighborhood],
  ['policy-dialog','Cancellation policy',listing.cancellation || 'Please confirm cancellation terms with your host before booking.'],
  ['rules-dialog','House rules',(listing.rules || ['Please confirm house rules with your host before booking.']).join('\n')],
  ['safety-dialog','Safety & property',(listing.safety || ['Please confirm safety equipment with your host.']).join('\n')],
  ['review-info-dialog','How reviews work','Ratings on property pages are based on reviews left by guests. The rating is the average of the available reviews.'],
  ['offer-dialog','Your next stay, for less','This reference preview demonstrates the 10% offer shown in the assignment. Claim applies a preview discount to your displayed total. No payment is taken.'],
  ['reservation-dialog','Your stay is selected','This property is an assignment preview. Your dates and guests are saved in this browser session. Explore the real listings to make a reservation.'],
  ['host-dialog','Contact your host',demo ? 'Mirashya Homes is the host shown in the reference design. Messaging is not available in this preview.' : 'Host: ' + host.username + '. Direct host messaging is not available in this project.'],
  ['report-dialog','Report this listing','For help with this property, contact the site administrator and include the listing URL.'],
]; %>
<% dialogs.forEach(([id,title,body])=>{ %><dialog id="<%= id %>" class="small-dialog" aria-labelledby="<%= id %>-title"><button class="circle-button" data-dialog-close aria-label="Close"><%- include('../includes/icon',{name:'close'}) %></button><h2 id="<%= id %>-title"><%= title %></h2><p class="dialog-copy"><%= body || '' %></p><% if (id==='reservation-dialog') { %><a href="/listings" class="outline-button">Explore homes</a><% } %></dialog><% }) %>
<dialog id="share-dialog" class="small-dialog" aria-labelledby="share-title"><button class="circle-button" data-dialog-close aria-label="Close"><%- include('../includes/icon',{name:'close'}) %></button><h2 id="share-title">Share this place</h2><p><%= listing.title %></p><label for="share-url">Listing link</label><input id="share-url" class="form-control" readonly><button id="copy-link" class="outline-button"><%- include('../includes/icon',{name:'copy'}) %>Copy link</button></dialog>
<dialog id="amenities-dialog" class="small-dialog" aria-labelledby="amenities-title"><button class="circle-button" data-dialog-close aria-label="Close"><%- include('../includes/icon',{name:'close'}) %></button><h2 id="amenities-title">What this place offers</h2><% let lastCategory=''; (listing.allAmenities || amenities).forEach(item=>{ if(item.category && item.category!==lastCategory){lastCategory=item.category; %><h3 class="amenity-category"><%= item.category %></h3><% } %><div class="amenity dialog-amenity <%= item.unavailable ? 'unavailable' : '' %>"><%- include('../includes/icon',{name:item.icon}) %><%= item.label %></div><% }) %></dialog>
<dialog id="reviews-dialog" class="small-dialog reviews-dialog" aria-labelledby="all-reviews-title"><button class="circle-button" data-dialog-close aria-label="Close"><%- include('../includes/icon',{name:'close'}) %></button><h2 id="all-reviews-title">Guest reviews · <%= rating || 'New' %></h2><% if(demo){ %><p class="muted">The reference shows 19 reviews in total; the six reviews available on its page are shown here.</p><% } %><% reviews.forEach(review=>{ %><article class="dialog-review"><h3><%= review.author?.username || 'Guest' %></h3><p aria-label="<%= review.rating %> out of 5 stars"><%= '★'.repeat(Math.round(review.rating || 0)) %></p><p><%= review.comment %></p></article><% }) %></dialog>
<script id="photo-data" type="application/json"><%- JSON.stringify(photos).replace(/</g,'\\u003c') %></script>
<% if (!demo && listing.geometry?.coordinates?.length === 2 && typeof mapToken !== 'undefined' && mapToken) { %><link href="https://api.mapbox.com/mapbox-gl-js/v2.13.0/mapbox-gl.css" rel="stylesheet"><script id="map-data" type="application/json"><%- JSON.stringify({token:mapToken,coordinates:listing.geometry.coordinates,location:listing.location}).replace(/</g,'\\u003c') %></script><script src="https://api.mapbox.com/mapbox-gl-js/v2.13.0/mapbox-gl.js" defer></script><% } %>
<script src="/js/listing.js" defer></script>
