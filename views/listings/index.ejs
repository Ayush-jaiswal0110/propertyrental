<% layout("/layouts/boilerplate") %>
<div class="explore-heading"><div><h1><%= location ? 'Stays in ' + location : 'Find your next stay' %></h1><p class="muted" id="listing-count" role="status"><%= allListings.length %> homes to explore</p></div><label class="sort-control">Sort by<select id="listing-sort" aria-label="Sort by"><option value="recommended">Recommended</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option></select></label></div>
<nav class="explore-filters" aria-label="Filter stays">
  <% [['All homes','home',''],['Beachfront','pool','beach|coast|ocean|sea'],['Countryside','location','countryside|farm|rural|tuscany|valley'],['City stays','work','city|downtown|urban|apartment'],['Mountain stays','home','mountain|cabin|alpine|aspen'],['With a pool','pool','pool'],['Unique stays','bed','treehouse|castle|historic|boat']].forEach(([title,icon,filter],i)=>{ %>
  <button type="button" class="category-button" data-listing-filter="<%= filter %>" aria-pressed="<%= i===0 %>"><%- include('../includes/icon',{name:icon}) %><span><%= title %></span></button><% }) %>
</nav>
<div class="explore-grid" id="listing-grid">
  <% allListings.forEach(listing=>{ %><a href="/listings/<%= listing._id %>" class="listing-links explore-card" data-price="<%= listing.price || 0 %>" data-keywords="<%= [listing.title,listing.description,listing.location,listing.country].join(' ').toLowerCase() %>">
    <div class="explore-image"><% if(listing.image?.url){ %><img src="<%= listing.image.url %>" alt="<%= listing.title %>" loading="lazy"><% } else { %><span class="no-photo">Photo coming soon</span><% } %></div>
    <h2><%= listing.title %></h2><p class="muted"><%= listing.location %>, <%= listing.country %></p><p><strong>₹<%= Number(listing.price || 0).toLocaleString('en-IN') %></strong> <span>night</span></p>
  </a><% }) %>
</div>
<div class="empty-state" id="no-listings" <%= allListings.length ? 'hidden' : '' %>><%- include('../includes/icon',{name:'search'}) %><h2>No stays found</h2><p>Try another destination or choose a different category.</p><a class="outline-button" href="/listings">Explore all homes</a></div>
<script src="/js/explore.js" defer></script>